+    const kp = genMlKem768Keypair();
+    const envelope = encryptNip44V2(kp.publicKey, new TextEncoder().encode("a"));
+    const parts = envelope.slice("pqc2:".length).split(".");
+    const mac = Buffer.from(parts[2]!, "base64url");
